---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'


interface Props {
  class?: string
  gap?: 'default' | 'none'
  smooth?: boolean
}

const { class: className, gap = 'default', smooth = false } = Astro.props
---

<!doctype html>
<html class="bg-background text-foreground" lang={SITE.locale}>
  <Head><slot name="head" /></Head>
  <body class="overflow-x-hidden">
    <div class={cn(
      "flex h-fit min-h-screen flex-col font-sans",
      gap === 'default' ? "gap-y-6" : "gap-y-0",
    )}>
      <!-- HEADER stays above everything -->
<div class="bg-background/50 fixed inset-x-0 top-0 z-[200] divide-y backdrop-blur-sm xl:divide-none">
  <Header />
  <slot name="subposts-navigation" />
  <slot name="table-of-contents" />
</div>


   {smooth ? (
  <div id="smooth-wrapper" class="z-0">
    <div id="smooth-content" class="pt-[var(--header-h,0px)]">
      <main class="grow">
        <div class={cn(
          "mx-auto flex grow flex-col px-4",
          Astro.url.pathname !== "/" && "max-w-3xl",
          className
        )}>
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </div>
      ) : (
        <>
          <main class="grow">
            <div class={cn(
              "mx-auto flex grow flex-col px-4",
              Astro.url.pathname !== "/" && "max-w-3xl",
              className
            )}>
              <slot />
            </div>
          </main>
          <Footer />
        </>
      )}
    </div>
  </body>
</html>
