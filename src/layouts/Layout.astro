---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  gap?: 'default' | 'none'
}
const { class: className, gap = 'default' } = Astro.props
---

<!doctype html>
<html class="bg-background text-foreground" lang={SITE.locale}>
  <Head>
    <slot name="head" />
  </Head>
  <body class="overflow-x-hidden">
    <div class={cn(
      "flex h-fit min-h-screen flex-col font-sans",
      gap === 'default' ? "gap-y-6" : "gap-y-0",
    )}>
      <!-- give the sticky header an id so we can measure it -->
      <div id="site-header" class="bg-background/50 sticky top-0 z-50 divide-y backdrop-blur-sm xl:divide-none">
        <Header />
        <slot name="subposts-navigation" />
        <slot name="table-of-contents" />
      </div>

      <main class="grow">
        <div class={cn(
          "mx-auto flex grow flex-col px-4",
          Astro.url.pathname !== "/" && "max-w-3xl",
          className
        )}>
          <slot />
        </div>
      </main>

      <Footer />
    </div>

    <!-- set --header-h so pages can offset sticky sections correctly -->
    <script is:inline>
      const setHeaderVar = () => {
        const el = document.getElementById('site-header')
        const h = el ? el.offsetHeight : 0
        document.documentElement.style.setProperty('--header-h', h + 'px')
      }
      // run ASAP after hydration + on resize (handles font swaps, etc.)
      addEventListener('astro:page-load', setHeaderVar)
      addEventListener('resize', setHeaderVar)
    </script>
  </body>
</html>
