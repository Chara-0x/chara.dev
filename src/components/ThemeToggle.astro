---
import { Button } from '@/components/ui/button'
import { Icon } from 'astro-icon/components'
---

<div class="relative flex flex-col items-end">
  <Button
    id="theme-toggle"
    variant="ghost"
    size="icon"
    title="Toggle theme"
    className="-me-2 size-8"
  >
    <Icon
      name="lucide:sun"
      class="size-4 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
    />
    <Icon
      name="lucide:moon"
      class="absolute size-4 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
    />
    <span class="sr-only">Toggle theme</span>
  </Button>
  <div
    id="theme-toggle-note"
    class="absolute right-0 top-[calc(100%+0.5rem)] w-52 translate-y-1 rounded-md border border-border bg-background px-3 py-2 text-xs text-foreground shadow-sm opacity-0 transition-[opacity,transform] duration-300 ease-out pointer-events-none"
    role="dialog"
    aria-hidden="true"
  >
    <p class="mb-2 text-left font-medium">Personally I'm a light mode person.</p>
    <button
      id="theme-toggle-confirm"
      type="button"
      class="inline-flex w-full items-center justify-center rounded-sm border border-border bg-muted px-3 py-1.5 text-xs font-medium text-foreground transition hover:border-foreground/40 hover:text-foreground"
    >
      Yes, I want dark mode
    </button>
  </div>
</div>

<script is:inline data-astro-rerun>
  const theme = (() => {
    const localStorageTheme = localStorage?.getItem('theme') ?? ''
    if (localStorageTheme === 'dark') {
      return 'dark'
    }
    return 'light'
  })()

  document.documentElement.setAttribute('data-theme', theme)
  document.documentElement.classList.add(
    theme === 'dark' ? 'scheme-dark' : 'scheme-light',
  )
  window.localStorage.setItem('theme', theme)
</script>

<script>
  type Theme = 'light' | 'dark'

  let isNoteVisible = false
  let outsideClickHandler: ((event: PointerEvent) => void) | null = null
  let outsideMoveHandler: ((event: PointerEvent) => void) | null = null
  let hideNoteTimeout: number | null = null

  function showThemeNote() {
    const note = document.getElementById('theme-toggle-note')
    const toggle = document.getElementById('theme-toggle')
    if (!note || !toggle || isNoteVisible) return

    if (hideNoteTimeout) {
      window.clearTimeout(hideNoteTimeout)
      hideNoteTimeout = null
    }

    note.classList.remove('opacity-0', 'translate-y-1', 'pointer-events-none')
    note.classList.add('opacity-100', 'translate-y-0')
    note.setAttribute('aria-hidden', 'false')
    isNoteVisible = true

    if (!outsideClickHandler) {
      outsideClickHandler = (event: PointerEvent) => {
        const target = event.target
        if (!(target instanceof Node)) {
          return
        }
        if (note.contains(target) || toggle.contains(target)) {
          return
        }
        hideThemeNote()
      }
      document.addEventListener('pointerdown', outsideClickHandler)
    }

    if (!outsideMoveHandler) {
      outsideMoveHandler = (event: PointerEvent) => {
        const target = event.target
        if (!(target instanceof Node)) {
          return
        }
        if (note.contains(target) || toggle.contains(target)) {
          return
        }
        hideThemeNote()
      }
      document.addEventListener('pointermove', outsideMoveHandler)
    }
  }

  function hideThemeNote() {
    const note = document.getElementById('theme-toggle-note')
    if (!note || !isNoteVisible) return

    note.classList.add('opacity-0', 'translate-y-1')
    note.classList.remove('opacity-100', 'translate-y-0')
    note.setAttribute('aria-hidden', 'true')
    isNoteVisible = false

    const duration = 300
    hideNoteTimeout = window.setTimeout(() => {
      note.classList.add('pointer-events-none')
      hideNoteTimeout = null
    }, duration)

    if (outsideClickHandler) {
      document.removeEventListener('pointerdown', outsideClickHandler)
      outsideClickHandler = null
    }

    if (outsideMoveHandler) {
      document.removeEventListener('pointermove', outsideMoveHandler)
      outsideMoveHandler = null
    }
  }

  function applyTheme(newTheme: Theme) {
    const element = document.documentElement

    element.classList.add('[&_*]:transition-none')
    element.setAttribute('data-theme', newTheme)
    element.classList.remove('scheme-dark', 'scheme-light')
    element.classList.add(newTheme === 'dark' ? 'scheme-dark' : 'scheme-light')

    window.getComputedStyle(element).getPropertyValue('opacity')

    requestAnimationFrame(() => {
      element.classList.remove('[&_*]:transition-none')
    })

    localStorage.setItem('theme', newTheme)
  }

  function confirmDarkMode() {
    applyTheme('dark')
    hideThemeNote()
  }

  function handleToggleClick() {
    const element = document.documentElement
    const currentTheme = element.getAttribute('data-theme')
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark'

    if (newTheme === 'dark') {
      showThemeNote()
      return
    }

    applyTheme(newTheme)
    hideThemeNote()
  }

  function initThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle')
    if (themeToggle && !themeToggle.dataset.initialized) {
      themeToggle.addEventListener('click', handleToggleClick)
      themeToggle.dataset.initialized = 'true'
    }

    const confirmButton = document.getElementById('theme-toggle-confirm')
    if (confirmButton && !confirmButton.dataset.initialized) {
      confirmButton.addEventListener('click', confirmDarkMode)
      confirmButton.dataset.initialized = 'true'
    }
  }

  initThemeToggle()

  document.addEventListener('astro:after-swap', () => {
    const storedTheme = localStorage.getItem('theme') || 'light'
    const element = document.documentElement

    element.classList.add('[&_*]:transition-none')

    window.getComputedStyle(element).getPropertyValue('opacity')

    element.setAttribute('data-theme', storedTheme)
    element.classList.remove('scheme-dark', 'scheme-light')
    element.classList.add(
      storedTheme === 'dark' ? 'scheme-dark' : 'scheme-light',
    )

    requestAnimationFrame(() => {
      element.classList.remove('[&_*]:transition-none')
    })

    initThemeToggle()
  })
</script>
