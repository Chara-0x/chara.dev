---
import DiscordPresence from '@/components/bento/DiscordPresence.tsx'
import GithubCalendar from '@/components/bento/GithubCalendar.tsx'
import SpotifyPresence from '@/components/bento/SpotifyPresence.tsx'
import WakatimeGraph from '@/components/bento/WakatimeGraph.tsx'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts } from '@/lib/data-utils'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import { buttonVariants } from '@/components/ui/button'

const latestPost = await getAllPosts().then((posts) => posts.at(0))
---

<Layout class="px-2">
  <PageHead slot="head" title="Home" />

  <section
    class={cn(
      'mx-auto grid min-w-xs sm:has-[[data-trigger]:hover]:*:first:[&_[data-overlay]]:opacity-0',
      'max-w-sm grid-cols-1 [grid-template-areas:"a""b""e""h""i""c""k""d""g""f""j"]',
      'sm:max-w-2xl sm:grid-cols-2 sm:[grid-template-areas:"a_a""b_d""e_e""j_g""h_i""h_c""k_c""f_f"]',
      'lg:max-w-5xl lg:grid-cols-3 lg:[grid-template-areas:"a_a_b""d_e_e""h_f_f""h_i_g""k_c_j"]',
      'xl:max-w-7xl xl:grid-cols-4 xl:[grid-template-areas:"a_a_b_c""d_e_e_c""h_f_f_g""h_i_j_k"]'
    )}
  >
    <!-- About / Intro (shadcn Card) -->
    <div class="aspect-[3/4] p-2 [grid-area:a] sm:aspect-[2/1] xl:aspect-[2/1]">
      <Card class="h-full bg-muted border">
        <CardHeader class="sm:flex sm:flex-row sm:gap-6">
          <div class="hidden w-1/3 sm:block"></div>
          <div class="sm:w-2/3">
            <CardTitle class="text-2xl">Hey, I’m Hy!</CardTitle>
            <CardDescription>
              Developer and student at Incheon National University, active online as hy and snow.
            </CardDescription>
          </div>
        </CardHeader>
        <CardContent class="space-y-4">
          <p class="text-sm text-foreground/80">
            I’m currently interested in Unity optimization and web backend development!
          </p>
          <p class="text-sm text-foreground/80">
            I adore subculture games and strawberry lattes ✨
          </p>
          <div class="flex gap-3">
            <Link href="/about" class={cn(buttonVariants({ variant: 'default', size: 'sm' }))}>
              Learn more
            </Link>
            <Link href="/projects" class={cn(buttonVariants({ variant: 'outline', size: 'sm' }))}>
              View projects
            </Link>
          </div>
        </CardContent>
      </Card>
    </div>

    <!-- Details hover tile -->
    <div class="aspect-square p-2 [grid-area:b]">
      <Card data-trigger class="h-full bg-muted border relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('/static/bento/details-background.png')] bg-cover bg-center" />
        <div class="absolute inset-0 bg-[url('/static/bento/details-foreground.png')] bg-cover bg-center transition-opacity duration-200 sm:opacity-0 sm:hover:opacity-100" />
        <CardContent class="h-full">
          <p class="text-foreground/80 bg-background absolute top-1/2 left-0 mr-24 ml-4 -translate-y-1/2 border p-3 text-xs">
            This site features notes on programming, tooling, and learning logs.
          </p>
        </CardContent>
      </Card>
    </div>

    <!-- Image tile -->
    <div class="aspect-square p-2 [grid-area:c] sm:aspect-[1/2] lg:aspect-square xl:aspect-[1/2]">
      <Card class="h-full bg-muted border overflow-hidden">
        <div class="size-full bg-[url('/static/bento/image-1.png')] bg-cover bg-center" />
      </Card>
    </div>

    <!-- Discord presence -->
    <div class="aspect-auto p-2 [grid-area:d] sm:aspect-square">
      <Card class="h-full bg-muted border">
        <CardContent class="h-full p-0">
          <DiscordPresence client:load />
        </CardContent>
      </Card>
    </div>

    <!-- Latest blog post highlight (shadcn + image) -->
    <div class="aspect-[6/5] p-2 [grid-area:e] sm:aspect-[2/1]">
      <Card data-trigger class="h-full bg-muted border relative overflow-hidden">
        <div class="absolute inset-0 group/blog bg-[url('/static/bento/blog-background-square.png')] bg-cover bg-center sm:bg-[url('/static/bento/blog-background.png')]" />
        <div class="absolute inset-0 bg-[url('/static/bento/blog-foreground-square.png')] bg-cover bg-center transition-opacity duration-200 sm:bg-[url('/static/bento/blog-foreground.png')] sm:opacity-0 sm:group-hover/blog:opacity-100" />
        <CardHeader class="sr-only">
          <CardTitle>Latest Post</CardTitle>
          <CardDescription>Read my newest blog post</CardDescription>
        </CardHeader>
        <CardContent class="size-full p-3 sm:p-6">
          {
            latestPost && (
              <Link href={`/blog/${latestPost.id}`} class="flex h-full">
                <img
                  src={latestPost.data.image?.src ?? '#'}
                  alt={`Featured image for the latest post: ${latestPost.data.title}`}
                  class="h-full w-auto border"
                  loading="lazy"
                />
              </Link>
            )
          }
        </CardContent>
        {
          latestPost && (
            <Link
              href={`/blog/${latestPost.id}`}
              title={`Read latest blog post: ${latestPost.data.title}`}
              aria-label={`Read latest blog post: ${latestPost.data.title}`}
              class="bg-border/50 text-primary ring-ring absolute end-0 bottom-0 m-3 rounded-full p-3 transition-[box-shadow] duration-300 hover:ring-2 focus-visible:ring-2"
            >
              <Icon name="lucide:move-up-right" size={16} />
            </Link>
          )
        }
      </Card>
    </div>

    <!-- GitHub calendar -->
    <div class="aspect-square p-2 [grid-area:f] sm:aspect-[2/1]">
      <Card data-trigger class="h-full bg-muted border relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('/static/bento/calendar-background.png')] bg-cover bg-left" />
        <div class="absolute inset-0 bg-[url('/static/bento/calendar-foreground.png')] bg-cover bg-left transition-opacity duration-200 sm:opacity-0 sm:hover:opacity-100" />
        <CardContent class="flex size-full items-center justify-center p-8">
          <GithubCalendar username="jktrn" client:load />
        </CardContent>
      </Card>
    </div>

    <!-- Spotify presence -->
    <div class="aspect-square p-2 [grid-area:g]">
      <Card data-trigger class="h-full bg-muted border relative overflow-hidden">
        <div class="absolute inset-0 group/spotify bg-[url('/static/bento/spotify-background.png')] bg-cover bg-center" />
        <div class="absolute inset-0 bg-[url('/static/bento/spotify-foreground.png')] bg-cover bg-center transition-opacity duration-200 sm:opacity-0 sm:group-hover/spotify:opacity-100" />
        <CardContent class="flex size-full items-center justify-center p-4">
          <SpotifyPresence client:load />
        </CardContent>
      </Card>
    </div>

    <!-- Image tile 2 -->
    <div class="aspect-square p-2 [grid-area:h] sm:aspect-[1/2]">
      <Card class="h-full bg-muted border overflow-hidden">
        <div class="size-full bg-[url('/static/bento/image-2.png')] bg-cover bg-center" />
      </Card>
    </div>

    <!-- GitHub link -->
    <div class="aspect-square p-2 [grid-area:i]">
      <Card class="h-full bg-muted border relative overflow-hidden">
        <div class="absolute inset-0 group/github flex items-center justify-center bg-[url('/static/bento/github-background.png')] bg-cover bg-center" />
        <div class="absolute inset-0 bg-[url('/static/bento/github-foreground.png')] bg-cover bg-center transition-opacity duration-200 sm:opacity-0 sm:group-hover/github:opacity-100" aria-hidden="true" />
        <CardContent class="flex size-full items-center justify-center">
          <Icon name="mdi:github" class="text-primary size-1/2 sm:size-24" aria-hidden="true" />
        </CardContent>
        <Link
          href="https://github.com/your-username"
          title="Visit my GitHub profile"
          aria-label="Visit my GitHub profile"
          external
          class="bg-border/50 text-primary ring-ring absolute end-0 bottom-0 m-3 rounded-full p-3 transition-[box-shadow] duration-300 hover:ring-2 focus-visible:ring-2"
        >
          <Icon name="lucide:move-up-right" size={16} />
        </Link>
      </Card>
    </div>

    <!-- Wakatime graph -->
    <div class="aspect-square p-2 [grid-area:j]">
      <Card class="h-full bg-muted border">
        <CardContent class="h-full p-0">
          <WakatimeGraph omitLanguages={['Markdown', 'JSON']} client:load />
        </CardContent>
      </Card>
    </div>

    <!-- Twitter/X -->
    <div class="aspect-square p-2 [grid-area:k]">
      <Card data-trigger class="h-full bg-muted border relative overflow-hidden">
        <div class="absolute inset-0 group/twitter bg-[url('/static/bento/twitter-background.png')] bg-cover bg-center" />
        <div class="absolute inset-0 bg-[url('/static/bento/twitter-foreground.png')] bg-cover bg-center transition-opacity duration-200 sm:opacity-0 sm:group-hover/twitter:opacity-100" aria-hidden="true">
          <p class="text-foreground/80 bg-background absolute bottom-4 left-4 hidden border p-2 text-xs sm:block">
            TypeScript is much better!
          </p>
        </div>
        <CardContent class="flex size-full items-center justify-center">
          <Icon name="mdi:twitter" class="text-primary size-1/2 sm:size-24" aria-hidden="true" />
        </CardContent>
        <Link
          href="https://twitter.com/your-handle"
          title="Visit my Twitter profile"
          aria-label="Visit my Twitter profile"
          external
          class="bg-border/50 text-primary ring-ring absolute end-0 bottom-0 m-3 rounded-full p-3 transition-[box-shadow] duration-300 hover:ring-2 focus-visible:ring-2"
        >
          <Icon name="lucide:move-up-right" size={16} />
        </Link>
      </Card>
    </div>
  </section>
</Layout>
