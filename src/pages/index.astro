<style is:inline>
  /* Crisp transforms on Safari/iOS */
  #intro-group { backface-visibility: hidden; }
</style>

<script is:inline>
  // Keep header height in a CSS var so the hero starts perfectly aligned.
  (function setHeaderVar() {
    const apply = () => {
      const stickyBar = document.querySelector('div.sticky.top-0')
      const header = stickyBar || document.querySelector('header')
      const h = header ? header.offsetHeight : 0
      document.documentElement.style.setProperty('--header-h', h + 'px')
    }
    apply()
    window.addEventListener('resize', apply, { passive: true })
    document.addEventListener('astro:after-swap', apply)
  })();
</script>

<!-- GSAP: ScrollTrigger + Flip (CDN ESM). Switch to npm imports if you prefer. -->
<script type="module" is:inline>
  import gsap from 'https://esm.sh/gsap@3.12.5'
  import ScrollTrigger from 'https://esm.sh/gsap@3.12.5/ScrollTrigger'
  import Flip from 'https://esm.sh/gsap@3.12.5/Flip'
  // NPM alternative:
  // import gsap from 'gsap'
  // import ScrollTrigger from 'gsap/ScrollTrigger'
  // import Flip from 'gsap/Flip'

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger, Flip)

    const hero      = document.getElementById('sticky-hero')
    const origin    = document.getElementById('hero-origin')
    const frame     = document.getElementById('intro-frame')
    const group     = document.getElementById('intro-group')
    const whisper   = document.getElementById('intro-whisper')
    const aboutDock = document.getElementById('about-dock')

    if (hero && origin && frame && group && aboutDock) {
      // Timeline scrubs 0 → 1 while the sticky section plays
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: hero,
          start: 'top top',     // hero reaches top of viewport
          end: 'bottom top',    // when sticky section ends
          scrub: 0.6,
          // markers: true,     // debug if needed
          onLeave: dockToAbout,     // finished → dock into grid
          onEnterBack: undockToHero // scrolling back up → return
        }
      })

      // 1) Drive CSS var --p for frame fade/border/background
      tl.to(frame, { '--p': 1, duration: 1 }, 0)

      // 2) Shrink & nudge the content slightly
      tl.to(group, {
        scale: 0.72,
        x: -8,
        y: -18,
        duration: 1
      }, 0)

      // 3) Whisper overlay subtle fade
      if (whisper) tl.to(whisper, { opacity: 0.4, duration: 1 }, 0)

      let docked = false

      function dockToAbout() {
        if (docked) return
        docked = true
        // Lock end-state styles before Flip (so the look matches)
        gsap.set(frame, { '--p': 1 })
        gsap.set(group, { clearProps: 'x,y,scale' }) // let Flip handle final geometry

        const state = Flip.getState(frame)
        aboutDock.appendChild(frame)
        Flip.from(state, {
          duration: 0.8,
          ease: 'power2.inOut'
        })
      }

      function undockToHero(self) {
        if (!docked) return
        docked = false
        const state = Flip.getState(frame)
        origin.appendChild(frame)
        Flip.from(state, {
          duration: 0.8,
          ease: 'power2.inOut'
        })
        // Restore scroll-driven transforms
        gsap.set(group, { clearProps: 'all' }) // timeline will re-apply on scrub
      }

      const refresh = () => ScrollTrigger.refresh()
      window.addEventListener('resize', refresh, { passive: true })
      document.addEventListener('astro:after-swap', refresh)
    }
  }
</script>
