---
import Layout from '@/layouts/Layout.astro'
import PageHead from '@/components/PageHead.astro'
import Link from '@/components/Link.astro'
import { cn } from '@/lib/utils'
import { SITE, SOCIAL_LINKS } from '@/consts'
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

// shadcn/ui
import { buttonVariants } from '@/components/ui/button'
import { Card, CardContent } from '@/components/ui/card'

// Client components
import DiscordPresence from '@/components/bento/DiscordPresence.tsx'
import GithubCalendar from '@/components/bento/GithubCalendar.tsx'
import SpotifyPresence from '@/components/bento/SpotifyPresence.tsx'
import WakatimeGraph from '@/components/bento/WakatimeGraph.tsx'

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)

const latestPost = blog.at(0)
---

<Layout class="px-2" gap="none" smooth>
  <PageHead slot="head" title="Home" description={SITE.DESCRIPTION} />

  <div id="scroll-track" class="relative h-[300vh]">
    
    <div class="sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center">
      
      <div id="bento-grid" class={cn(
        'relative w-full max-w-7xl p-4 grid min-w-xs z-10',
        // Grid Layout
        'grid-cols-1 gap-3 [grid-template-areas:"a""b""c""d""e""f""g""h""i""j""k"]',
        'sm:max-w-2xl sm:grid-cols-2 sm:[grid-template-areas:"a_a""b_d""e_e""j_g""h_i""h_c""k_c""f_f"]',
        'lg:max-w-5xl lg:grid-cols-3 lg:[grid-template-areas:"a_a_b""d_e_e""h_f_f""h_i_g""k_c_j"]',
        'xl:max-w-7xl xl:grid-cols-4 xl:[grid-template-areas:"a_a_b_c""d_e_e_c""h_f_f_g""h_i_j_k"]',
      )}>

        <div id="intro-card" class="[grid-area:a] z-50 origin-center opacity-0 will-change-transform">
          <Card 
            id="intro-inner" 
            class="h-full w-full overflow-hidden border-transparent bg-transparent shadow-none transition-all"
          >
            <div class="relative h-full w-full p-6 sm:p-10 flex flex-col justify-center">
              <div id="intro-decor" class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,var(--primary)_0%,transparent_40%)] opacity-0"></div>
              
              <div class="relative z-10">
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-4">
                  Haiiiiii! <span class="text-primary">^-^</span>
                </h1>
                <p class="text-muted-foreground text-lg sm:text-xl max-w-lg leading-relaxed">
                  My name is <span class="font-medium text-foreground">Chara</span>! Nice to meet you.<br/>
                  I build stuff for the web.
                </p>
                <div class="mt-6 flex gap-3">
                  <Link href="/about" class={cn(buttonVariants({ variant: 'default' }))}>About me</Link>
                  <Link href="/projects" class={cn(buttonVariants({ variant: 'outline' }))}>Projects</Link>
                </div>
              </div>
            </div>
          </Card>
        </div>

        <div class="bento-item [grid-area:b] aspect-square sm:aspect-auto">
          <Card class="size-full bg-[url('/static/bento/details-background.png')] bg-cover"></Card>
        </div>

        <div id="discord-card" class="[grid-area:c] z-40 origin-center h-full min-h-[160px] opacity-0 will-change-transform">
           <div class="h-full w-full">
             <DiscordPresence client:load />
           </div>
        </div>

        <div class="bento-item [grid-area:d] aspect-square sm:aspect-auto">
          <Card class="size-full overflow-hidden">
             <div class="size-full bg-[url('/static/bento/image-1.png')] bg-cover bg-center"></div>
          </Card>
        </div>

        <div class="bento-item [grid-area:e] aspect-[2/1]">
          <Card class="size-full overflow-hidden group relative bg-muted">
             {latestPost && (
               <Link href={`/blog/${latestPost.slug ?? latestPost.id}`} class="block h-full w-full">
                 <img src={latestPost.data.image?.src} alt={latestPost.data.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                 <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-6">
                    <span class="text-white font-medium text-lg">{latestPost.data.title}</span>
                 </div>
               </Link>
             )}
          </Card>
        </div>

        <div class="bento-item [grid-area:f] aspect-square sm:aspect-auto">
           <Card class="size-full flex items-center justify-center p-4 overflow-hidden">
              <GithubCalendar username={SOCIAL_LINKS.find(l => l.label === 'GitHub')?.username ?? 'chara-0x'} client:load />
           </Card>
        </div>

        <div class="bento-item [grid-area:g] aspect-square">
           <Card class="size-full overflow-hidden p-0">
              <div class="flex size-full items-center justify-center">
                 <SpotifyPresence client:load />
              </div>
           </Card>
        </div>

        <div class="bento-item [grid-area:h] aspect-square sm:aspect-[1/2]">
           <Card class="size-full overflow-hidden bg-[url('/static/bento/image-2.png')] bg-cover bg-center"></Card>
        </div>

        <div class="bento-item [grid-area:i] aspect-square">
           <Card class="size-full bg-[#24292e] text-white flex items-center justify-center">
              <Icon name="mdi:github" class="size-16" />
           </Card>
        </div>

        <div class="bento-item [grid-area:j] aspect-square">
           <Card class="size-full"><CardContent class="p-0 size-full"><WakatimeGraph omitLanguages={['Markdown', 'JSON']} client:load /></CardContent></Card>
        </div>

        <div class="bento-item [grid-area:k] aspect-square">
           <Card class="size-full bg-[#1DA1F2] text-white flex items-center justify-center">
              <Icon name="mdi:twitter" class="size-16" />
           </Card>
        </div>

      </div>
    </div>
  </div>
  
  <div class="h-24"></div>
</Layout>

<style>
  /* Hide items initially, GSAP will reveal them */
  .bento-item {
    visibility: hidden; 
    opacity: 0;
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context;

  function initAnimations() {
    if (ctx) ctx.revert();

    ctx = gsap.context(() => {
      const scrollTrack = document.querySelector('#scroll-track');
      const introCard = document.querySelector('#intro-card') as HTMLElement;
      const introInner = document.querySelector('#intro-inner') as HTMLElement;
      const introDecor = document.querySelector('#intro-decor') as HTMLElement;
      const discordCard = document.querySelector('#discord-card') as HTMLElement;
      const bentoItems = document.querySelectorAll('.bento-item');

      if (!scrollTrack || !introCard || !discordCard) return;

      // --- 1. Calculate Correct Initial Positions ---
      const getHeroTransform = (element: HTMLElement, isDiscord = false) => {
        const rect = element.getBoundingClientRect();
        const viewW = window.innerWidth;
        const viewH = window.innerHeight;
        
        const currentX = rect.left;
        const currentY = rect.top;

        let heroX, heroY;
        const centerX = viewW / 2;
        const centerY = viewH / 2;
        
        // Gap between the two elements in Hero State
        const visualGap = 40; 

        if (viewW > 1024) {
          // DESKTOP LOGIC
          if (isDiscord) {
            // Discord (Right Side)
            // Left edge should be at Center + Half Gap
            heroX = centerX + (visualGap / 2);
            heroY = centerY - (rect.height / 2);
          } else {
            // Intro (Left Side)
            // Right edge should be at Center - Half Gap
            heroX = centerX - (visualGap / 2) - rect.width;
            heroY = centerY - (rect.height / 2);
          }
        } else {
          // MOBILE LOGIC (Stacked)
          heroX = (viewW - rect.width) / 2; // Center horizontally
          const totalHeight = rect.height + 200; 
          const startY = (viewH - totalHeight) / 2;
          
          if (isDiscord) {
            heroY = startY + 220;
          } else {
            heroY = startY;
          }
        }

        return { x: heroX - currentX, y: heroY - currentY };
      };

      const introStart = getHeroTransform(introCard, false);
      const discordStart = getHeroTransform(discordCard, true);

      // --- 2. Main Timeline ---
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#scroll-track",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
        }
      });

      // --- 3. Intro Animation (Left -> Grid) ---
      tl.fromTo(introCard, 
        { 
          x: introStart.x, 
          y: introStart.y, 
          scale: 1.15, 
          opacity: 1,
          zIndex: 50
        },
        { 
          x: 0, 
          y: 0, 
          scale: 1, 
          opacity: 1,
          zIndex: 10, 
          ease: "power2.inOut",
          duration: 1
        }, 
        0
      );
      
      // 3b. Intro Styling (Transparent Floating Text -> Card Box)
      tl.fromTo(introInner,
        { 
          backgroundColor: "rgba(0,0,0,0)", 
          borderColor: "rgba(0,0,0,0)", 
          boxShadow: "none" 
        },
        { 
          backgroundColor: "hsl(var(--background))", 
          borderColor: "hsl(var(--border))", 
          boxShadow: "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
          duration: 0.8,
          ease: "power1.in"
        },
        0
      );
      
      if(introDecor) {
        tl.fromTo(introDecor, { opacity: 0 }, { opacity: 0.1, duration: 1 }, 0);
      }

      // --- 4. Discord Animation (Right -> Grid) ---
      tl.fromTo(discordCard, 
        { 
          x: discordStart.x, 
          y: discordStart.y, 
          scale: 1.15, 
          opacity: 1,
          zIndex: 40
        },
        { 
          x: 0, 
          y: 0, 
          scale: 1, 
          opacity: 1,
          zIndex: 10,
          ease: "power2.inOut",
          duration: 1
        }, 
        0
      );

      // --- 5. Bento Items Fade In ---
      // Use autoAlpha: 1 to force visibility back on
      tl.fromTo(bentoItems, 
        { y: 50, autoAlpha: 0 },
        { 
          y: 0, 
          autoAlpha: 1, // Sets opacity:1 AND visibility:visible
          stagger: 0.05, 
          ease: "power2.out", 
          duration: 0.6 
        }, 
        0.4
      );

    });
  }

  document.addEventListener('astro:page-load', initAnimations);
  
  document.addEventListener('astro:before-swap', () => {
    if (ctx) ctx.revert();
  });
</script>