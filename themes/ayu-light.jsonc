{
	"$schema": "vscode://schemas/color-theme",
	"type": "light",
	"colors": {
	
	},
	"tokenColors": [
		{
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#ffffff99",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"constant.language"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter.function-call"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"variable.member"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"variable.language"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"storage"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"keyword"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#ffffffB3"
			}
		},
		{
			"scope": [
				"punctuation.section"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"punctuation.definition.template-expression"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"meta.embedded"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"source.java storage.type",
				"source.haskell storage.type",
				"source.c storage.type"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"storage.type.function"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"source.java storage.type.primitive"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"entity.name.function"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"meta.parameter"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"variable.function",
				"variable.annotation",
				"meta.function-call.generic",
				"support.function.go"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"support.function",
				"support.macro"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"entity.name.import",
				"entity.name.package"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"entity.name"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"support.class.component"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"punctuation.definition.tag.end",
				"punctuation.definition.tag.begin",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#ffffff80"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"support.constant"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"support.type",
				"support.class",
				"source.go storage.type"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"meta.decorator variable.other",
				"meta.decorator punctuation.decorator",
				"storage.type.annotation"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"meta.diff",
				"meta.diff.header"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"source.ruby variable.other.readwrite"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"source.css entity.name.tag",
				"source.sass entity.name.tag",
				"source.scss entity.name.tag",
				"source.less entity.name.tag",
				"source.stylus entity.name.tag"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"source.css support.type",
				"source.sass support.type",
				"source.scss support.type",
				"source.less support.type",
				"source.stylus support.type"
			],
			"settings": {
				"foreground": "#ffffff99"
			}
		},
		{
			"scope": [
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "normal"
			}
		},
		{
			"scope": [
				"constant.numeric.line-number.find-in-files - match"
			],
			"settings": {
				"foreground": "#ffffff99"
			}
		},
		{
			"scope": [
				"constant.numeric.line-number.match"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"entity.name.filename.find-in-files"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"message.error"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic markup.bold",
				"markup.bold markup.italic"
			],
			"settings": {
				"fontStyle": "bold italic"
			}
		},
		{
			"scope": [
				"markup.raw"
			],
			"settings": {
				"background": "#ffffff05"
			}
		},
		{
			"scope": [
				"markup.raw.inline"
			],
			"settings": {
				"background": "#ffffff0F"
			}
		},
		{
			"scope": [
				"meta.separator"
			],
			"settings": {
				"foreground": "#ffffff99",
				"background": "#ffffff0F",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.list punctuation.definition.list.begin"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"markup.strike"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"markup.table"
			],
			"settings": {
				"foreground": "#ffffff",
				"background": "#ffffff0F"
			}
		},
		{
			"scope": [
				"text.html.markdown markup.inline.raw"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"text.html.markdown meta.dummy.line-break"
			],
			"settings": {
				"foreground": "#ffffff99",
				"background": "#ffffff99"
			}
		},
		{
			"scope": [
				"punctuation.definition.markdown"
			],
			"settings": {
				"foreground": "#ffffff99",
				"background": "#ffffff"
			}
		},
		{
			"scope": "ref.matchtext",
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#ffffff"
			}
		}
	]
}